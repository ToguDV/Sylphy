# =============================================================================
# Sylphy environment variables
# Copy this file to `.env` and fill in your real values, then remove the
# `.example` suffix (see README.md -> "Environment setup").
#
# WARNING: Never commit the real `.env` file. It is git-ignored.
# =============================================================================

# Your Telegram bot token, obtained from @BotFather (required).
# Format: 1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chat ID of the Telegram chat where notifications will be delivered (required).
# The app fails fast at startup if this is missing.
# Tip: send a message to your bot and check https://api.telegram.org/bot<TOKEN>/getUpdates
# to find the chat id (it can be negative for groups).
TELEGRAM_NOTIFICATION_CHAT_ID=your_chat_id_here

# API key for the LLM provider (OpenAI-compatible endpoint) used by the
# assistant to understand messages, drive tools, and compose notifications (required).
SPRING_AI_OPENAI_API_KEY=your_openai_compatible_api_key_here
